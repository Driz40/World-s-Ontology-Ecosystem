    </owl:DatatypeProperty>

    <!-- ============ Individuals ============ -->

    <!-- A graduate teaching assistant: both a student and a professor. -->
    <owl:NamedIndividual rdf:about="http://example.org/university-courses#JaneDoe">
        <rdf:type rdf:resource="http://example.org/university-courses#Student"/>
        <rdf:type rdf:resource="http://example.org/university-courses#Professor"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/university-courses#CS101">
