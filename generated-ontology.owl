        <creditHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</creditHours>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/university-courses#CS201">
        <rdf:type rdf:resource="http://example.org/university-courses#Course"/>
