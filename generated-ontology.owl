    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-courses#hasGrade"/>

    <!-- ============ Data Properties ============ -->

    <owl:DatatypeProperty rdf:about="http://example.org/university-courses#courseTitle">
        <rdfs:domain rdf:resource="http://example.org/university-courses#Course"/>
