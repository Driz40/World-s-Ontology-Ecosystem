    <owl:Ontology rdf:about="http://example.org/university-courses">
        <rdfs:comment>University Courses ontology. Aligned with BFO 2020. Supports catalog, scheduling, prerequisite, enrollment, and grading questions.</rdfs:comment>
    </owl:Ontology>

    <!-- ============ Classes ============ -->

    <owl:Class rdf:about="http://example.org/university-courses#Person"/>

    <owl:Class rdf:about="http://example.org/university-courses#Student">
        <rdfs:subClassOf rdf:resource="http://example.org/university-courses#Person"/>
        <rdfs:comment>A class that represents students.</rdfs:comment>
        <owl:disjointWith rdf:resource="http://example.org/university-courses#Professor"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-courses#Professor">
        <rdfs:subClassOf rdf:resource="http://example.org/university-courses#Person"/>
        <rdfs:comment>A class that represents professors.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-courses#Course">
        <rdfs:comment>A Course is a course that is offered by a university.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-courses#CreditHour">
        <rdfs:comment>A CreditHour is a unit of academic credit.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-courses#Enrollment">
        <rdfs:comment>When a student enrolls in a course.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-courses#Prerequisite">
        <rdfs:comment>A Prerequisite is a course that must be taken before another course.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university-courses#Department"/>

    <owl:Class rdf:about="http://example.org/university-courses#Semester"/>

    <owl:Class rdf:about="http://example.org/university-courses#Grade"/>

    <!-- ============ Object Properties ============ -->

    <owl:ObjectProperty rdf:about="http://example.org/university-courses#teaches">
        <rdfs:domain rdf:resource="http://example.org/university-courses#Professor"/>
        <rdfs:range rdf:resource="http://example.org/university-courses#Course"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university-courses#hasInstructor">
